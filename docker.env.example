# Thiết lập khi chạy bằng Docker (Phase 7). Chép thành tệp .env cạnh docker-compose.yml:
#   copy docker.env.example .env        (Windows)
#   cp docker.env.example .env          (macOS, Linux)
# Mọi dòng đều tùy chọn: để trống thì dùng mặc định.

# Cổng mở giao diện: http://localhost:8080
WEB_PORT=8080

# Thư mục sao lưu trên máy. Nên đặt ở ổ đĩa khác, ví dụ D:/sao-luu-nha-thuoc (dùng dấu /).
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=14
BACKUP_TIME=23:00

# Mật khẩu CSDL: CHỈ đặt trước lần chạy đầu tiên (CSDL đã tạo rồi thì đổi ở đây không có tác dụng).
POSTGRES_PASSWORD=

# Để trống: phần mềm tự sinh lần đầu và giữ trong volume "secrets".
JWT_SECRET=
ANALYTICS_READER_PASSWORD=

# Mở bằng https (có chứng chỉ) thì đặt true. Dùng http trong mạng nội bộ thì để false.
COOKIE_SECURE=false

# Trợ lý AI (tùy chọn)
ANTHROPIC_API_KEY=

# Gửi email đơn đặt hàng (tùy chọn). Gmail: smtp.gmail.com, 465, SMTP_SECURE=true, mật khẩu ứng dụng.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
