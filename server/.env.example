# Mẫu cấu hình máy chủ. Chép thành .env rồi sửa giá trị thật.
# KHÔNG commit file .env.

NODE_ENV="development"
PORT=3000

# Chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://gpp:MAT_KHAU@localhost:5432/pharmacy_gpp"
# CSDL riêng cho kiểm thử tự động (vitest xóa sạch dữ liệu trong CSDL này).
# Tên CSDL phải kết thúc bằng _test, nếu không test sẽ không chạy.
DATABASE_URL_TEST="postgresql://gpp:MAT_KHAU@localhost:5432/pharmacy_gpp_test"

# Khóa ký access token, tối thiểu 16 ký tự. Mỗi môi trường một khóa riêng.
JWT_SECRET="doi-thanh-chuoi-bi-mat-dai-ngau-nhien"

# Địa chỉ giao diện web được phép gọi API
CORS_ORIGIN="http://localhost:5173"

LOG_LEVEL="info"

# Chạy sau reverse proxy (nginx...) thì bỏ dấu # và đặt số proxy tin cậy (thường là 1),
# để máy chủ đọc đúng IP người dùng. Gọi thẳng máy chủ thì để nguyên.
# TRUST_PROXY=1

# Địa chỉ API Hệ thống CSDL về Dược. Bỏ trống thì dùng địa chỉ chính thức
# theo môi trường đã chọn ở màn Liên thông (sandbox hoặc hệ thống thật).
# Chỉ đặt khi Bộ Y tế đổi tên miền mà phần mềm chưa kịp cập nhật.
# NDS_BASE_URL="https://api-sandbox.csdlduoc.com.vn/v2"
