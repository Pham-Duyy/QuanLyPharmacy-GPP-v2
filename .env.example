# Mẫu biến môi trường. Sao chép thành server/.env khi dựng backend:
#   cp .env.example server/.env
# File .env thật không được commit (đã có trong .gitignore).

# Khớp với docker-compose.yml
DATABASE_URL="postgresql://gpp:gpp_dev_password@localhost:5432/pharmacy_gpp"
DATABASE_URL_TEST="postgresql://gpp:gpp_dev_password@localhost:5432/pharmacy_gpp_test"

# Máy chủ
NODE_ENV=development
PORT=3000

# Chuỗi bí mật ký JWT. Môi trường thật phải đổi thành chuỗi ngẫu nhiên dài.
JWT_SECRET="doi-thanh-chuoi-ngau-nhien-that-dai-truoc-khi-chay-that"

# Múi giờ: lưu UTC, hiển thị theo giờ Việt Nam (docs/api-contract.md §2.1)
TZ=UTC

# Trợ lý phân tích (contract §20.1). Bỏ trống thì trợ lý chạy bằng luật,
# không gửi dữ liệu nào ra ngoài. Đặt khóa Claude API để AI hiểu câu hỏi và viết nhận xét.
# ANTHROPIC_API_KEY=
# ANALYTICS_AI_MODEL=claude-opus-5-5
